    opacity:0; transform:translateY(24px);
    transition:opacity 0.6s ease, transform 0.6s ease;
  }
  html.js-reveal .feature-grid.is-visible .f-card{ opacity:1; transform:translateY(0); }
  html.js-reveal .feature-grid.is-visible .f-card:nth-child(1){ transition-delay:0.05s; }
  html.js-reveal .feature-grid.is-visible .f-card:nth-child(2){ transition-delay:0.12s; }
  html.js-reveal .feature-grid.is-visible .f-card:nth-child(3){ transition-delay:0.19s; }
  html.js-reveal .feature-grid.is-visible .f-card:nth-child(4){ transition-delay:0.26s; }
  html.js-reveal .feature-grid.is-visible .f-card:nth-child(5){ transition-delay:0.33s; }
  html.js-reveal .feature-grid.is-visible .f-card:nth-child(6){ transition-delay:0.4s; }

